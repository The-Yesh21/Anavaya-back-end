digraph DecisionPath {
  rankdir=TB;
  node [shape=box, style="rounded,filled", fillcolor="#F7FBFF", color="#4B5563", fontname="Arial"];
  edge [color="#6B7280", fontname="Arial"];
  n0 [label="Node 0\nBroad case type is one of: Cyber, Financial, Non-Violent, Property\nCase value: 2 (Non-Violent)\nDecision: Yes"];
  n1 [label="Node 1\nVulnerability is one of: High\nCase value: 1 (Low)\nDecision: No"];
  n0 -> n1 [label="step 1"];
  n3 [label="Node 3\nInfluence / power imbalance is one of: High\nCase value: 0 (High)\nDecision: Yes"];
  n1 -> n3 [label="step 2"];
  n4 [label="Leaf node 4\nPredicted priority: Medium\nSamples: 93"];
  n3 -> n4 [label="step 3"];
}