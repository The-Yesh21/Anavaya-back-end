{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/courtroom",
      "destination": "/dashboard/courtroom.html"
    },
    {
      "source": "/court/:roomId*",
      "destination": "/dashboard/courtroom.html"
    }
  ]
}
