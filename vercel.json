{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "cleanUrls": true,
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "build": {
    "env": {
      "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/courtroom",
      "destination": "/dashboard/courtroom"
    },
    {
      "source": "/court/:roomId/companion",
      "destination": "/dashboard/companion-cam"
    },
    {
      "source": "/court/:roomId",
      "destination": "/dashboard/courtroom"
    },
    {
      "source": "/:file(courtroom\\.js|courtroom\\.css|companion-cam\\.js|node-status\\.js|node-status\\.css|tokens\\.css|tailwind-init\\.js|qrcode\\.min\\.js|invite\\.js|face-observations\\.js|trial-emotion-inference\\.js|trial_emotion_classifier\\.json)",
      "destination": "/dashboard/:file"
    },
    {
      "source": "/mediapipe/:file*",
      "destination": "/dashboard/mediapipe/:file*"
    },
    {
      "source": "/vendor/lottie.min.js",
      "destination": "/dashboard/vendor/lottie.min.js"
    },
    {
      "source": "/assets/:file(talking\\.gif|courtroom-countdown\\.json)",
      "destination": "/dashboard/assets/:file"
    }
  ]
}
